table "default"."regions" {
  primaryKey = {
    columns = <
      {
        name = region_id
      }

    >
    name = "regions_pk"
    objectType = primaryKey
  }
  columns = (
    column "region_id" {
      type = bigint
      notNull = NOT NULL
      generatedAs = ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1)
    }
    column "region_name" {
      type = string
      notNull = NOT NULL
    }
  )
}

